# ─────────────────────────────────────────────────────────────────────────────
#  Copy to `.env` locally — or set the same keys as Secrets on Hugging Face.
#  NEVER commit a real .env. Seriously. The internet never forgets.
# ─────────────────────────────────────────────────────────────────────────────

# Telegram bot token from @BotFather  (required)
BOT_TOKEN=123456789:replace-me

# Comma-separated Telegram user IDs allowed into the Admin Mini App (required)
# Tip: send /id to the bot (or to @userinfobot) to learn yours.
ADMIN_IDS=123456789

# Long random string used to encrypt stored cookies (required, keep private)
SECRET_KEY=change-me-to-a-long-random-string

# Public https URL of this deployment — used for the Admin Web App button.
# On Hugging Face you may leave it empty: it is auto-derived from SPACE_ID.
# PUBLIC_BASE_URL=https://your-space.hf.space

# Optional: initial proxy (any common format, see README). Admin panel can
# change it at runtime without a restart.
# PROXY=silver.ciaude.co.uk:8080:username:password

# Optional behaviour limits
MAX_FILESIZE_MB=49
MAX_GLOBAL_DOWNLOADS=3
SEARCH_MAX_DURATION=600

# Local-only escape hatch: open the Admin API without Telegram initData.
# NEVER enable this in production.
# DEBUG_ADMIN=0
